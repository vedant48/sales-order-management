# Base URL of the backend API (no trailing slash). Leave empty to use the Vite dev proxy.
VITE_API_URL=http://localhost:3000

# Firebase web app configuration (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Firebase console -> Project settings -> Cloud Messaging -> Web configuration)
VITE_FIREBASE_VAPID_KEY=
