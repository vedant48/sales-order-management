# Server
PORT=3000
# Comma-separated list of allowed frontend origins for CORS (use * for local dev)
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/sales_orders
# Set to "true" when the database requires SSL (e.g. hosted Postgres)
DATABASE_SSL=false

# Firebase Admin SDK service account (from Firebase console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Private key with newlines escaped as \n (single line)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
